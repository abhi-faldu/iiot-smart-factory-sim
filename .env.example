# Copy this file to .env and fill in real values before running docker-compose.
# .env is git-ignored — never commit the real file.

# InfluxDB
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-strong-password
INFLUX_ORG=factory
INFLUX_BUCKET=sensors
INFLUX_TOKEN=change-me-long-random-token

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-strong-password

# API — comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
